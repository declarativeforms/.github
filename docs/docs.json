{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Declarative Forms",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
