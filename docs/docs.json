            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/forms",
              "concepts/sections",
              "concepts/fields",
              "concepts/completion",
              "concepts/connections",
              "concepts/validation",
              "concepts/conditional-logic",
              "concepts/templating",
              "concepts/localization",
              "concepts/analytics"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/declarativeforms"
      }
    ],
    "primary": {
      "type": "button",
