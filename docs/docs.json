{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Declarative Forms",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/multiple-sections",
              "guides/conditional-navigation"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/short-text-field",
              "reference/long-text-field"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/declarativeforms"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.declarativeforms.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/declarativeforms"
    }
  }
}
