          {
            "group": "Reference",
            "pages": [
              "reference/form-reference",
              "reference/section-reference",
              "reference/address-field",
              "reference/address-locality-field",
              "reference/address-region-field",
              "reference/address-country-field",
              "reference/date-field",
              "reference/dropdown-field",
              "reference/email-field",
              "reference/file-upload-field",
              "reference/geolocation-field",
              "reference/hidden-field",
              "reference/long-text-field",
              "reference/mobile-number-field",
              "reference/multiple-select-field",
              "reference/number-field",
              "reference/rating-field",
              "reference/signature-field",
              "reference/short-text-field",
              "reference/single-select-field",
              "reference/url-field"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/support"
            ]
          }
